# Copy this file to `.env` and adjust for your environment, then run any example
# with `-e .env`, e.g.:
#
#   stratum apply -c examples/configs/schema.smql -e .env
#
# The values below match the local test setup described in the README
# (Sakila on MySQL, an empty target DB on PostgreSQL). They are local-only
# development credentials.

# Host ports the compose databases bind to. Defaults are deliberately non-standard
# (15432/13306, not 5432/3306) so `docker compose up -d` works even if you already
# run PostgreSQL or MySQL locally. To remap, change the port here AND in the URLs
# below - they must agree.
POSTGRES_PORT=15432
MYSQL_PORT=13306

MYSQL_URL=mysql://sakila_user:qwerty123@localhost:13306/sakila
POSTGRES_URL=postgres://user:password@localhost:15432/testdb

PAGILA_URL=postgres://user:password@localhost:15432/pagila
MYSQL_DEST_URL=mysql://sakila_user:qwerty123@localhost:13306/pagila