// Benchmark: transform-heavy single-table load, MySQL -> PostgreSQL.
//
// Same `bench.orders` source as synthetic.ppl, with a balanced set of ~19
// computed/copied columns: a few string functions (concat / upper / lower /
// trim), several arithmetic expressions, some date extraction, and a handful of
// copied-through source columns. This stresses the transform path (compiled
// expressions, per-batch schema derivation) with a realistic mix.
//
// URLs come from the environment; run.sh exports them for the bench databases.

connection "src" {
    driver = "mysql"
    url    = env("BENCH_SYNTH_MYSQL_URL")
}

connection "dst" {
    driver = "postgres"
    url    = env("BENCH_SYNTH_PG_URL")
}

pipeline "orders_heavy" {
    from {
        connection = connection.src
        table      = "orders"
    }

    to {
        connection = connection.dst
        table      = "orders_heavy"

        postgres {
            pk_creation = "post"
            copy_format = "binary"
        }
    }

    select {
        order_id    = orders.id

        // Copied-through source columns.
        customer_id = orders.customer_id
        status      = orders.status
        currency    = orders.currency
        amount      = orders.amount

        // String functions.
        s1 = concat(orders.currency, "-", orders.sku)
        s2 = upper(orders.status)
        s3 = lower(orders.sku)
        s4 = concat(orders.sku, "_", orders.currency, "_", orders.status)
        s5 = upper(concat(orders.currency, orders.status))
        s6 = trim(orders.sku)

        // Arithmetic.
        a1 = orders.amount * orders.quantity
        a2 = orders.amount * 2
        a3 = orders.quantity + 10
        a4 = orders.amount * orders.quantity + orders.customer_id
        a5 = orders.customer_id * 3 + orders.quantity

        // Date extraction.
        d1 = year(orders.created_at)
        d2 = month(orders.created_at)
        d3 = quarter(orders.created_at)
    }

    settings {
        create_missing_tables = true
        batch_size            = 50000
        lanes                 = 1
    }
}
