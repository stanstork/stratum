// Benchmark: synthetic single-table load with 4 parallel lanes, MySQL -> PostgreSQL.
//
// Identical to synthetic.ppl but `lanes = 4`: Paganel splits the single-table
// snapshot into 4 contiguous primary-key ranges and copies them concurrently,
// each on its own source/destination connection. This shows how a single large
// table parallelizes (compare its rows/s against the 1-lane `synthetic` run).
//
// NOTE: lanes currently parallelize a table ONLY when it has an INTEGER primary
// key - Paganel range-splits on that key (min..max). A table without an integer
// PK transparently falls back to a single lane (no error, just no speedup).
// `orders` has a BIGINT PK, so it splits cleanly.
//
// URLs come from the environment; run.sh exports them for the bench databases.

connection "src" {
    driver = "mysql"
    url    = env("BENCH_SYNTH_MYSQL_URL")
}

connection "dst" {
    driver = "postgres"
    url    = env("BENCH_SYNTH_PG_URL")
}

pipeline "orders" {
    from {
        connection = connection.src
        table      = "orders"
    }

    to {
        connection = connection.dst
        table      = "orders"

        postgres {
            pk_creation = "post"
            copy_format = "binary"
        }
    }

    settings {
        create_missing_tables = true
        batch_size            = 50000
        lanes                 = 4
    }
}
