// Benchmark: synthetic single-table load through a native Rust WASM plugin,
// MySQL -> PostgreSQL. Paganel only (pgloader has no plugin transforms).
//
// Same `bench.orders` source as synthetic.ppl. Each row crosses the WASM plugin
// boundary THREE times (the `order_net` plugin computes a * b), and several
// source columns are copied through unchanged - so this measures the real cost
// of repeated plugin invocation plus a realistic write width. 
// Paired with synthetic_plugin_js.ppl (identical logic in JS) 
// so the two plugin runtimes are directly comparable; and with
// synthetic.ppl (no transform) / synthetic_heavy.ppl (built-in expressions).

connection "src" {
    driver = "mysql"
    url    = env("BENCH_SYNTH_MYSQL_URL")
}

connection "dst" {
    driver = "postgres"
    url    = env("BENCH_SYNTH_PG_URL")
}

plugin "order_net" {
    path = env("BENCH_PLUGIN_RUST_WASM")
}

pipeline "orders_plugin_rust" {
    from {
        connection = connection.src
        table      = "orders"
    }

    to {
        connection = connection.dst
        table      = "orders_plugin_rust"

        postgres {
            pk_creation = "post"
            copy_format = "binary"
        }
    }

    select {
        // Copy original columns through.
        order_id    = orders.id
        customer_id = orders.customer_id
        status      = orders.status
        currency    = orders.currency
        amount      = orders.amount
        quantity    = orders.quantity
        sku         = orders.sku
        created_at  = orders.created_at

        // Three native-Rust plugin calls per row (each is one boundary crossing).
        net   = plugin.order_net({ amount: orders.amount,   quantity: orders.quantity })
        score = plugin.order_net({ amount: orders.quantity, quantity: orders.customer_id })
        ext   = plugin.order_net({ amount: orders.amount,   quantity: orders.customer_id })
    }

    settings {
        create_missing_tables = true
        batch_size            = 50000
        lanes                 = 1
    }
}
