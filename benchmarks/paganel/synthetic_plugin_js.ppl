// Benchmark: synthetic single-table load through a JavaScript WASM plugin,
// MySQL -> PostgreSQL. Paganel only (pgloader has no plugin transforms).
//
// Identical to synthetic_plugin_rust.ppl except the `order_net` transform is
// the JavaScript plugin (compiled to WASM via QuickJS), so the JS and native
// Rust plugin runtimes are measured on the same work: three boundary crossings
// per row plus a realistic set of copied-through columns.

connection "src" {
    driver = "mysql"
    url    = env("BENCH_SYNTH_MYSQL_URL")
}

connection "dst" {
    driver = "postgres"
    url    = env("BENCH_SYNTH_PG_URL")
}

plugin "order_net" {
    path = env("BENCH_PLUGIN_JS_WASM")
}

pipeline "orders_plugin_js" {
    from {
        connection = connection.src
        table      = "orders"
    }

    to {
        connection = connection.dst
        table      = "orders_plugin_js"

        postgres {
            pk_creation = "post"
            copy_format = "binary"
        }
    }

    select {
        // Copy original columns through.
        order_id    = orders.id
        customer_id = orders.customer_id
        status      = orders.status
        currency    = orders.currency
        amount      = orders.amount
        quantity    = orders.quantity
        sku         = orders.sku
        created_at  = orders.created_at

        // Three JS plugin calls per row (each is one boundary crossing).
        net   = plugin.order_net({ amount: orders.amount,   quantity: orders.quantity })
        score = plugin.order_net({ amount: orders.quantity, quantity: orders.customer_id })
        ext   = plugin.order_net({ amount: orders.amount,   quantity: orders.customer_id })
    }

    settings {
        create_missing_tables = true
        batch_size            = 50000
        lanes                 = 1
    }
}
