// Benchmark: synthetic single-table load, MySQL -> PostgreSQL.
//
// One table (`bench.orders`, generated by ../synthetic/generate.sql - mixed
// types, ~200 byte rows, deterministic values), copied end-to-end including
// destination table creation. This isolates raw data-movement throughput from
// the many-small-tables overhead the Sakila workload measures.
//
// URLs come from the environment; run.sh exports them for the bench databases.

connection "src" {
    driver = "mysql"
    url    = env("BENCH_SYNTH_MYSQL_URL")
}

connection "dst" {
    driver = "postgres"
    url    = env("BENCH_SYNTH_PG_URL")
}

pipeline "orders" {
    from {
        connection = connection.src
        table      = "orders"
    }

    to {
        connection = connection.dst
        table      = "orders"
    }

    settings {
        create_missing_tables = true
        batch_size            = 50000
    }
}
