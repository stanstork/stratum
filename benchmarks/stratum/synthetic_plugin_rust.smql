// Benchmark: synthetic single-table load through a native Rust WASM plugin,
// MySQL -> PostgreSQL. Stratum only (pgloader has no plugin transforms).
//
// Same `bench.orders` source as synthetic.smql, but each row's `net` column is
// computed by the `order_net` transform plugin (compiled from native Rust to
// wasm32). Paired with synthetic_plugin_js.smql (identical logic in JS) so the
// two plugin runtimes are directly comparable; and with synthetic.smql (no
// transform) / synthetic_heavy.smql (built-in expressions) as reference points.
//
// The plugin .wasm and the URLs come from the environment; run.sh builds the
// plugin and exports the paths.

connection "src" {
    driver = "mysql"
    url    = env("BENCH_SYNTH_MYSQL_URL")
}

connection "dst" {
    driver = "postgres"
    url    = env("BENCH_SYNTH_PG_URL")
}

plugin "order_net" {
    path = env("BENCH_PLUGIN_RUST_WASM")
}

pipeline "orders_plugin_rust" {
    from {
        connection = connection.src
        table      = "orders"
    }

    to {
        connection = connection.dst
        table      = "orders_plugin_rust"

        postgres {
            pk_creation = "post"
            copy_format = "binary"
        }
    }

    select {
        order_id = orders.id
        net      = plugin.order_net({ amount: orders.amount, quantity: orders.quantity })
    }

    settings {
        create_missing_tables = true
        batch_size            = 50000
        lanes                 = 1
    }
}
