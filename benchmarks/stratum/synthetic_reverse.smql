// Benchmark: synthetic single-table load, PostgreSQL -> MySQL (reverse direction).
//
// The counterpart to synthetic.smql, run stratum-only: pgloader migrates *into*
// PostgreSQL, so there is no pgloader comparison for a MySQL destination. This
// isolates the write path that matters here - the MySQL `LOAD DATA` fast path
// and the PgToMysql type converter - from the forward (COPY-into-PG) numbers.
//
// Source is a PG `orders` table seeded by ../synthetic/generate_pg.sql; the
// destination table is created fresh each run. URLs come from the environment,
// exported by run.sh for the bench databases.

connection "src" {
    driver = "postgres"
    url    = env("BENCH_REV_PG_URL")
}

connection "dst" {
    driver = "mysql"
    url    = env("BENCH_REV_MYSQL_URL")
}

pipeline "orders_reverse" {
    from {
        connection = connection.src
        table      = "orders"
    }

    to {
        connection = connection.dst
        table      = "orders"
    }

    settings {
        create_missing_tables = true
        batch_size            = 50000
        lanes                 = 1
    }
}
