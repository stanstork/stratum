// Verify: payment table with DEFAULT (OFFSET/LIMIT) pagination
//
// Tests verify at scale with the simplest pagination strategy.
// OFFSET-based batches have no cursor state - the receipt records
// row counts per batch and verify replays pages by batch index.
//
// payment: 16,044 rows, batch_size=500 -> 33 pages (32 full + 1 partial).



pipeline "verify_payment_default" {
    from { connection = connection.src  table = "payment" }
    to   { connection = connection.dst  table = "payment" }

    settings {
        create_missing_tables = true
        batch_size            = 500
    }
}
