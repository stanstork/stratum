// Verify prerequisite: language table
//
// Sakila language is a small lookup table (6 rows) referenced by film.language_id.
// This migration runs WITHOUT integrity (no receipt written) - its sole purpose is
// to satisfy the FK constraint before migrating film.



pipeline "migrate_language" {
    from { connection = connection.src  table = "language" }
    to   { connection = connection.dst  table = "language" }

    settings {
        create_missing_tables = true
        batch_size            = 20
    }
}
