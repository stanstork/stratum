// Verify: simple table - actor
//
// Sakila actor: actor_id (SMALLINT PK), first_name (VARCHAR), last_name (VARCHAR),
//               last_update (TIMESTAMP WITH TIME ZONE)
//
// Good baseline: no FKs, small row count (~200 rows), straightforward types.



pipeline "migrate_actor" {
    from { connection = connection.src  table = "actor" }
    to   { connection = connection.dst  table = "actor" }

    settings {
        create_missing_tables = true
        batch_size            = 50
    }
}
