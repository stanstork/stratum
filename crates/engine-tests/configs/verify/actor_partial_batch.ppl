// Verify: actor with batch_size that leaves a partial last batch
//
// Sakila actor has 200 rows. batch_size=77 produces 2 full batches (77+77=154 rows)
// and 1 partial batch (46 rows) - tests that the partial last batch verifies correctly.



pipeline "migrate_actor" {
    from { connection = connection.src  table = "actor" }
    to   { connection = connection.dst  table = "actor" }

    settings {
        create_missing_tables = true
        batch_size            = 77
    }
}
