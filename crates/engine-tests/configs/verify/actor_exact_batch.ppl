// Verify: actor with batch_size == row count (exact boundary)
//
// Sakila actor has 200 rows. batch_size=200 produces exactly 1 batch with
// no remainder - tests that a single full batch verifies correctly.



pipeline "migrate_actor" {
    from { connection = connection.src  table = "actor" }
    to   { connection = connection.dst  table = "actor" }

    settings {
        create_missing_tables = true
        batch_size            = 200
    }
}
