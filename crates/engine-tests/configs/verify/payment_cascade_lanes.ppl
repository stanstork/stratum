// Verify: cascade migration across parallel table lanes
//
// Same shape as payment_cascade.ppl (payment root, FK depth 1 pulling customer,
// staff, rental) but with `lanes = 4`, so the discovered tables migrate
// concurrently instead of one after another.

pipeline "migrate_payment_cascade_lanes" {
    from {
        connection = connection.src
        table      = "payment"

        with references {
            data  = cascade
            depth = 1
        }
    }

    to { connection = connection.dst }

    settings {
        create_missing_tables = true
        batch_size            = 500
        lanes                 = 4
    }
}
