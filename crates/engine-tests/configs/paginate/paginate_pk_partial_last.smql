// Pagination: PK strategy - batch_size does not evenly divide row count
//
// 200 actor rows, batch_size=77 -> 2 full pages (154 rows) + 1 partial (46 rows).
// Verifies that the partial last page is not silently dropped.



pipeline "pk_partial_last_page" {
    from { connection = connection.src  table = "actor" }
    to   { connection = connection.dst  table = "actor" }

    paginate {
        strategy = "pk"
        cursor   = "actor.actor_id"
    }

    settings {
        create_missing_tables = true
        batch_size            = 77
    }
}
