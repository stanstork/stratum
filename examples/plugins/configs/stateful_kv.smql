// stateful_kv.smql - the KV + METRICS capabilities in a transform plugin.
//
// `running_total` keeps a running sum across rows using the instance-scoped KV
// store (`allow_kv`) and emits metrics (`allow_metrics`). It reads Sakila's
// `actor` table and writes an `actor_running` table with each row's cumulative
// total of `actor_id`.
//
//   stratum plugin validate -c examples/plugins/configs/stateful_kv.smql
//   stratum apply           -c examples/plugins/configs/stateful_kv.smql -e .env
//
// What to confirm:
//   - `running` climbs monotonically (1, 3, 6, 10, ...) - proof the KV state
//     carries across rows and batches within the run.
//   - the `plugin::metrics` log target shows the `running_total` gauge and the
//     `rows_seen` counter (run with -v if you don't see them).
//   - re-running starts the total from zero again (KV is not persisted).

define {
    mysql_url    = env("MYSQL_URL")
    postgres_url = env("POSTGRES_URL")
}

connection "src" { driver = "mysql"    url = define.mysql_url    }
connection "dst" { driver = "postgres" url = define.postgres_url }

plugin "running_total" {
    path          = "examples/plugins/js/running_total.js"
    allow_kv      = true
    allow_metrics = true
}

pipeline "accumulate" {
    from { connection = connection.src  table = "actor" }
    to   { connection = connection.dst  table = "actor_running" }

    select {
        actor_id = actor.actor_id
        running  = plugin.running_total({ value: actor.actor_id })
    }

    // Single lane so the running total is global (with parallel lanes each lane
    // keeps its own instance-scoped total).
    settings { create_missing_tables = true  batch_size = 50 }
}
