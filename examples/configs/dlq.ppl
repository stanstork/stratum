// dlq.ppl - Dead Letter Queue (DLQ): capturing rows that fail validation
//
// When a row fails a `validate` check with `action = fail`, Paganel writes the
// offending row - along with its error details - to the dead-letter table
// configured in `on_error.failed_rows`, and then aborts the pipeline. The DLQ
// preserves the bad rows for inspection and reprocessing instead of losing
// them when the run stops.
//
// (Note: `action = fail` stops the migration. Use `action = skip` to drop bad
// rows and keep going - but skipped rows are NOT sent to the DLQ. The DLQ also
// captures transformation/data errors, which do not stop the pipeline.)
//
// This example migrates payment rows and rejects any with amount = 0. The first
// zero-amount payment is saved to `payment_failures` and the run then aborts.
//
// Run:
//   pag apply -c dlq.ppl -e .env
//
// After apply, inspect the DLQ:
//   SELECT pipeline_name, error_message, original_data
//   FROM payment_failures;

define {
    mysql_url    = env("MYSQL_URL")
    postgres_url = env("POSTGRES_URL")
}

connection "src" { driver = "mysql"    url = define.mysql_url    }
connection "dst" { driver = "postgres" url = define.postgres_url }

pipeline "migrate_payments" {
    from { connection = connection.src  table = "payment" }
    to   { connection = connection.dst  table = "payment" }

    validate {
        // Reject zero-amount payments - they indicate a data quality problem.
        // Rows that fail this check are sent to the DLQ table instead of
        // being written to the destination.
        assert "positive_amount" {
            check   = payment.amount > 0
            message = "Payment amount must be positive"
            action  = fail
        }
    }

    // Any row that triggers the `fail` assertion is captured here before the
    // pipeline aborts - so the bad row is preserved rather than silently lost.
    on_error {
        failed_rows {
            table {
                connection = connection.dst
                table      = "payment_failures"
            }
        }
    }

    select {
        payment_id   = payment.payment_id
        customer_id  = payment.customer_id
        staff_id     = payment.staff_id
        rental_id    = payment.rental_id
        amount       = payment.amount
        payment_date = payment.payment_date
    }

    settings {
        create_missing_tables = true
        batch_size            = 500
    }
}
