// pagila-graph.smql - Graph-reference migration (PostgreSQL -> MySQL)
//
// Instead of listing every table as its own pipeline (see pagila.smql), this
// declares a single ROOT table and lets Stratum discover the rest by walking
// the foreign-key graph. This is the test for "how relations are created":
// the destination tables are built in topological order and their FK
// relationships are re-created (two-phase, so circular refs are handled).
//
// `with references { data = cascade, depth = all }`:
//   - introspects the FK graph starting at `rental`
//   - discovers every ancestor table it depends on (inventory -> film -> language,
//     customer -> address -> city -> country, staff <-> store, ...)
//   - creates them in dependency order, then adds FK constraints as a second phase
//   - `data = cascade` migrates the data for all discovered tables too
//     (use `data = schema_only` to create just the tables + relations, no rows)
//
// NOTE: unlike pagila.smql, this does NOT set `ignore_constraints`, so foreign
// keys ARE created in MySQL - that's the point of this config. The circular
// staff <-> store FK is resolved by deferring constraint creation to after the
// tables exist.
//
// Setup (same as pagila.smql - see its header for details):
//   docker exec -i mysql_db mysql -uroot -proot -e \
//     "CREATE DATABASE IF NOT EXISTS pagila; \
//      GRANT ALL ON pagila.* TO 'sakila_user'@'%'; FLUSH PRIVILEGES;"
//   MySQL needs local_infile for the LOAD DATA fast path:
//     docker exec -i mysql_db mysql -uroot -proot -e "SET GLOBAL local_infile=1;"
//
// .env:
//   PAGILA_URL     = postgres://user:password@localhost:5432/pagila
//   MYSQL_DEST_URL = mysql://sakila_user:qwerty123@localhost:3306/pagila
//
// Run (plan first to inspect the discovered creation order + FK ops):
//   stratum plan  -c pagila-graph.smql -e .env
//   stratum apply -c pagila-graph.smql -e .env
//
// Inspect the created relations afterwards:
//   docker exec -i mysql_db mysql -uroot -proot pagila -e "SHOW CREATE TABLE rental\G"
//   docker exec -i mysql_db mysql -uroot -proot pagila -e \
//     "SELECT table_name, column_name, referenced_table_name, referenced_column_name \
//      FROM information_schema.key_column_usage \
//      WHERE table_schema='pagila' AND referenced_table_name IS NOT NULL;"

define {
    pg_url    = env("PAGILA_URL")
    mysql_url = env("MYSQL_DEST_URL")
}

connection "pg"    { driver = "postgres" url = define.pg_url    }
connection "mysql" { driver = "mysql"    url = define.mysql_url }

pipeline "graph_from_rental" {
    from {
        connection = connection.pg
        table      = "rental"

        with references {
            data  = cascade   // also migrate discovered tables' data (schema_only = DDL only)
            depth = all       // traverse the whole FK graph (or a positive integer to limit)
        }
    }

    to {
        connection = connection.mysql
    }

    // The root `select` maps the `from` table (rental). Field renames here only
    // touch the rental table.
    select {
        rental_id    = rental.rental_id
        rental_date  = rental.rental_date
        inventory_id = rental.inventory_id
        customer_id  = rental.customer_id
        return_date  = rental.return_date
        staff_id     = rental.staff_id
        updated_at   = rental.last_update   // rename last_update -> updated_at
    }

    // NAMED SELECTS: each discovered table can override its own field mapping.

    // dim-style rename of customer's name fields.
    select "customer" {
        customer_id   = customer.customer_id
        store_id      = customer.store_id
        given_name    = customer.first_name   // first_name  -> given_name
        family_name   = customer.last_name    // last_name   -> family_name
        email         = customer.email
        address_id    = customer.address_id
        activebool    = customer.activebool
        registered_at = customer.create_date  // create_date -> registered_at
        last_update   = customer.last_update
        active        = customer.active
    }

    // warehouse-style rename of film's rental fields.
    select "film" {
        film_id              = film.film_id
        title                = film.title
        description          = film.description
        year                 = film.release_year      // release_year    -> year
        language_id          = film.language_id
        original_language_id = film.original_language_id
        rent_days            = film.rental_duration    // rental_duration -> rent_days
        price                = film.rental_rate        // rental_rate     -> price
        length               = film.length
        replacement_cost     = film.replacement_cost
        rating               = film.rating
        last_update          = film.last_update
        special_features     = film.special_features
        fulltext             = film.fulltext
    }

    settings {
        create_missing_tables = true
        batch_size            = 500
    }
}
